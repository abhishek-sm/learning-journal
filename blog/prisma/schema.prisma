// ==========================================================
// Prisma schema — Personal Learning Journal
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// User — single admin account. No public registration.
// --------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// --------------------------------------------------------
// Category — supports one level of nesting (parent/child)
// e.g. Science -> Physics, Evolution, Biology
// --------------------------------------------------------
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  order       Int        @default(0)

  parentId    String?
  parent      Category?  @relation("CategoryToChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToChildren")

  articles    Article[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

// --------------------------------------------------------
// Tag — optional, many-to-many with Article
// --------------------------------------------------------
model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  articles  Article[] @relation("ArticleToTag")

  createdAt DateTime  @default(now())

  @@map("tags")
}

// --------------------------------------------------------
// Article — the core content unit
// --------------------------------------------------------
model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  coverImage    String?
  content       String    @db.Text // raw markdown
  readingTime   Int       @default(1) // minutes, computed on save
  published     Boolean   @default(false)
  publishedAt   DateTime?
  featured      Boolean   @default(false)

  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags          Tag[]     @relation("ArticleToTag")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
  @@map("articles")
}
