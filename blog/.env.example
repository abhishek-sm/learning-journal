# # --- Database ---
# # Local Postgres example:
# # DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_journal"
# # Neon example (get this from your Neon project dashboard):
# # DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL=""

# # --- Auth ---
# # Any long random string. Generate one with: openssl rand -base64 32
# AUTH_SECRET=""

# # Used only by `npm run db:seed` to create your one admin account.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="changeme123"

# # --- Site ---
# # Used for SEO metadata, Open Graph, RSS, and the sitemap.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
